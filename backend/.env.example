# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: anthropic | openai | google | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

ANTHROPIC_API_KEY=sk-ant-...       # required if LLM_PROVIDER=anthropic
OPENAI_API_KEY=sk-...              # required if LLM_PROVIDER=openai
GOOGLE_API_KEY=AIza...             # required if LLM_PROVIDER=google
OLLAMA_BASE_URL=http://localhost:11434  # required if LLM_PROVIDER=ollama

# ── Database Provider ─────────────────────────────────────────────────────────
# Supported: supabase | postgres
DB_PROVIDER=supabase

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

DATABASE_URL=postgresql+asyncpg://user:pass@host/db  # used if DB_PROVIDER=postgres

# ── Auth Provider ─────────────────────────────────────────────────────────────
# Supported: supabase | jwt
AUTH_PROVIDER=supabase
JWT_SECRET=your-supabase-jwt-secret
JWT_AUDIENCE=authenticated
JWT_ALGORITHM=HS256
# JWKS_URL=https://cognito-idp.ap-south-1.amazonaws.com/POOL_ID/.well-known/jwks.json

# ── Billing Provider ──────────────────────────────────────────────────────────
# Supported: razorpay | stripe
BILLING_PROVIDER=razorpay
CURRENCY=INR

# Razorpay (India — primary)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_SUBSCRIPTION_PLAN_ID=plan_...   # create once in Razorpay dashboard

# Stripe (international — optional)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_METERED_PRICE_ID=price_...

# ── Credit Pack Pricing (in paise — 100 paise = ₹1) ──────────────────────────
CREDIT_PACK_SMALL_MESSAGES=100
CREDIT_PACK_SMALL_PRICE=9900       # ₹99

CREDIT_PACK_MEDIUM_MESSAGES=300
CREDIT_PACK_MEDIUM_PRICE=24900     # ₹249

CREDIT_PACK_LARGE_MESSAGES=800
CREDIT_PACK_LARGE_PRICE=59900      # ₹599

SUBSCRIPTION_MONTHLY_PRICE=29900   # ₹299/month
SUBSCRIPTION_MESSAGE_LIMIT=1000

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
FREE_MESSAGE_QUOTA=50
MAX_MESSAGES_PER_DAY=50
CORS_ORIGINS=http://localhost:3000
APP_URL=https://safeshoulder.app
